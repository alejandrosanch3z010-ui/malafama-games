# ---------------------------------------------------------------
#  Mala Fama Games — configuración de Apache (un solo archivo)
# ---------------------------------------------------------------

# 1) API REST: toda ruta /api/... llega al enrutador de la API
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/enrutador.php?ruta=$1 [QSA,L]

# 2) Protege archivos sensibles aunque alguien conozca la ruta
<FilesMatch "^\.env|\.sql$|\.md$|\.gitignore$">
    Require all denied
</FilesMatch>
Options -Indexes
